#!/usr/bin/env bash
# Stub of curl for tests: copies $FIXTURES/<last path segment of the URL> to
# the file given by --output, and fails like curl --fail when it is missing.
# The URL is appended to $CALLS.
set -euo pipefail
output="" url=""
while (($#)); do
  case $1 in
    --output)
      output=$2
      shift 2
      ;;
    --proto | --retry | --connect-timeout | --max-time)
      shift 2
      ;;
    -*) shift ;;
    *)
      url=$1
      shift
      ;;
  esac
done
echo "curl $url" >>"$CALLS"
file=$FIXTURES/${url##*/}
if [[ ! -f $file ]]; then
  echo "curl: (22) The requested URL returned error: 404" >&2
  exit 22
fi
cp -- "$file" "$output"
